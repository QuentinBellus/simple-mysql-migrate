{
  "name": "simple-mysql-migrate",
  "version": "2.0.0",
  "description": "Dead simple MySQL schema migration for Node.js — scans a folder of .sql files and applies them in order, tracking applied versions in a schema_version table.",
  "homepage": "https://github.com/QuentinBellus/simple-mysql-migrate",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/QuentinBellus/simple-mysql-migrate.git"
  },
  "bugs": {
    "url": "https://github.com/QuentinBellus/simple-mysql-migrate/issues"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc",
    "test": "jest --config jestconfig.json",
    "prepare": "npm run build"
  },
  "keywords": [
    "mysql",
    "migration",
    "migrations",
    "schema",
    "database",
    "flyway",
    "sql"
  ],
  "author": "Quentin Bellus",
  "license": "ISC",
  "engines": {
    "node": ">=14"
  },
  "files": [
    "dist/**/*",
    "README.md",
    "LICENSE"
  ],
  "peerDependencies": {
    "mysql2": ">=3.0.0"
  },
  "devDependencies": {
    "@types/jest": "^29.5.12",
    "@types/node": "^20.11.30",
    "jest": "^29.7.0",
    "mysql2": "^3.9.4",
    "ts-jest": "^29.1.2",
    "typescript": "^5.4.3"
  }
}